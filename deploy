#!/usr/bin/env bash
# Produktion auf dem Server (Docker Compose, ein Container, ein Port; Reverse Proxy macht der Betreiber).
#   ./deploy          Quellen synchronisieren, Image bauen, Container (neu) starten, auf "healthy" warten
#   ./deploy logs     Container-Log folgen
#   ./deploy stop     Container stoppen und entfernen (Spielstände bleiben im Volume)
#   ./deploy cron     Sicherung alle 6 Stunden per Cron auf dem Server einrichten (14 Tage aufbewahren)
#   ./deploy backup   Spielstände und Eroberungen (profiles.json, territory.json) nach ~/osp-backups auf dem Server kopieren
# Die .env liegt nur auf dem Server; beim ersten Lauf wird sie mit Standardwerten angelegt (siehe .env.example).
set -euo pipefail
HOST=daniel@192.168.178.20
DIR=/home/daniel/osp-prod
cd "$(dirname "$0")"

case "${1:-}" in
  logs) exec ssh $HOST "cd $DIR && docker compose logs -f --tail 100 osp" ;;
  stop) exec ssh $HOST "cd $DIR && docker compose down" ;;
  cron)
    # Sicherung per Cron einrichten (alle 6 Stunden, 14 Tage aufbewahren); mehrfaches Ausführen ist harmlos
    scp -q scripts/backup_server.sh $HOST:osp-backup.sh
    ssh $HOST 'chmod +x ~/osp-backup.sh && mkdir -p ~/osp-backups       && ( crontab -l 2>/dev/null | grep -v "osp-backup.sh"; echo "15 */6 * * * \$HOME/osp-backup.sh >> \$HOME/osp-backups/backup.log 2>&1" ) | crontab -       && echo "Cron eingerichtet:" && crontab -l | grep osp-backup.sh'
    exit 0 ;;
  backup)
    ssh $HOST "mkdir -p ~/osp-backups && stamp=\$(date +%Y%m%d-%H%M%S) && docker cp osp:/data/profiles.json ~/osp-backups/profiles-\$stamp.json && (docker cp osp:/data/territory.json ~/osp-backups/territory-\$stamp.json 2>/dev/null || true) && ls -1t ~/osp-backups | head -6"
    exit 0 ;;
esac

echo "→ Quellen synchronisieren"
ssh $HOST "mkdir -p $DIR"
tar c --exclude=./deps --exclude=./_build --exclude=./node_modules --exclude=./.git --exclude=./.env . | ssh $HOST "tar x -C $DIR"

echo "→ .env prüfen"
ssh $HOST "cd $DIR && if [ ! -f .env ]; then cp .env.example .env; echo '   .env neu angelegt (Standardwerte)'; else echo '   .env vorhanden'; fi"

echo "→ Sicherung der Spielstände (falls der Container läuft)"
ssh $HOST "mkdir -p ~/osp-backups && stamp=\$(date +%Y%m%d-%H%M%S) && (docker cp osp:/data/territory.json ~/osp-backups/territory-\$stamp.json 2>/dev/null || true) && docker cp osp:/data/profiles.json ~/osp-backups/profiles-\$stamp.json 2>/dev/null && echo '   gesichert' || echo '   (noch keine Spielstände)'"

echo "→ Image bauen und starten"
ssh $HOST "cd $DIR && docker compose up -d --build"

echo "→ Warte auf Health-Check"
for i in $(seq 1 45); do
  state=$(ssh $HOST "docker inspect -f '{{.State.Health.Status}}' osp 2>/dev/null || echo none")
  if [ "$state" = healthy ]; then
    port=$(ssh $HOST "grep '^HOST_PORT=' $DIR/.env | cut -d= -f2")
    echo "✔ läuft: Port ${port:-4100} auf dem Server (Proxy muss WebSocket-Upgrades auf /ws weiterreichen)"
    exit 0
  fi
  sleep 2
done

echo "✘ nicht healthy nach 90 s – letzte Logs:" >&2
ssh $HOST "cd $DIR && docker compose logs --tail 40 osp" >&2
exit 1
