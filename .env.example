# Wird auf dem Server als .env im Projektordner abgelegt (nicht ins Repo!).

# Port auf dem Host, auf dem das Spiel erreichbar ist (der Container hört intern auf 4000)
HOST_PORT=4200

# Seed der Hauptwelt (Zahl). Leer = bei jedem Start eine neue zufällige Welt.
OSP_SEED=

# Anzahl Wander-Bots in der Hauptwelt
OSP_BOTS=3

# Erlaubte WebSocket-Origins, kommasepariert (z. B. https://osp.example.com). Leer = keine Prüfung.
OSP_ORIGINS=
